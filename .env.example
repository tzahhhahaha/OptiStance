# Supabase Configuration (Primary Backend Database)
# Get these from https://supabase.com → Your Project → Settings → API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# NOTE: VITE_SUPABASE_SERVICE_ROLE_KEY is intentionally not included.
# Service role keys are SECRET and must NEVER be exposed in client-side code.
# They should only be used in server-side environments (e.g., Supabase Edge Functions,
# Node.js backends, or serverless functions) with a server-side env variable.

# App settings
VITE_APP_NAME=CheerPose