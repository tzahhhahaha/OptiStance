node_modules/
.env*
src/.env*

# Build output. Never commit this: it is regenerated by `npm run build`, it
# changes on every build, and it now embeds the ~18 MB vendored MediaPipe
# runtime from public/mediapipe/. Tracking it caused stale-APK bugs (shipping
# old JavaScript after a "fix") and needless merge conflicts.
dist/

# Supabase CLI local state — contains the DB password in plaintext (pooler-url)
supabase/.temp/
.env.supabase

# Stray local artifacts
temp_pom_glossary.pdf
*.local

# MediaPipe pose runtime — vendored out of node_modules by
# scripts/vendor-mediapipe.mjs (runs via prebuild/predev). ~18 MB of WASM and
# model binaries that would otherwise be committed on every build. They are
# regenerated from the pinned @mediapipe/pose version, so there is nothing to
# review here.
public/mediapipe/