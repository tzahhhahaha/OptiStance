<?xml version="1.0" encoding="utf-8"?>
<!--
  Android status-bar notification icon.

  Android ignores colour here: the icon is rendered as a monochrome silhouette
  against the status bar, so this is a solid white shape on a transparent
  background. It must be the cheer mark, simplified to a single fill, and it
  must not rely on colour to be legible.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">

    <!-- Head -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M12,2.6m-2.1,0a2.1,2.1 0 1,0 4.2,0a2.1,2.1 0 1,0 -4.2,0" />

    <!-- Torso -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.9,6.1h2.2v6.1h-2.2z" />

    <!-- Left arm, raised -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.6,6.4h1.8v1.55h-1.8z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M5.3,3.1l1.3,-1.25l4.1,4.2l-1.3,1.25z" />

    <!-- Right arm, raised -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.6,6.4h1.8v1.55h-1.8z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13.3,6.05l4.1,-4.2l1.3,1.25l-4.1,4.2z" />

    <!-- Stance leg -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.9,12.1h2.2v1.6h-2.2z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6.6,16.4l1.3,-1.25l3.5,3.6l-1.3,1.25z" />

    <!-- Lifted leg -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13.1,15.5l4.1,-2.6l0.95,1.45l-4.1,2.6z" />
</vector>
