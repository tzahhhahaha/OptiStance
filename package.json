{
  "name": "cheerpose-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev:android": "npm run vendor:mediapipe && vite build && npx cap sync && npx cap open android",
    "dev:ios": "npm run vendor:mediapipe && vite build && npx cap sync && npx cap open ios",
    "build": "vite build",
    "build:android": "npm run vendor:mediapipe && vite build && npx cap sync && npx cap open android",
    "build:ios": "npm run vendor:mediapipe && vite build && npx cap sync && npx cap open ios",
    "vendor:mediapipe": "node scripts/vendor-mediapipe.mjs",
    "predev": "npm run vendor:mediapipe",
    "prebuild": "npm run vendor:mediapipe",
    "sync": "npx cap sync",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "test": "vitest",
    "qa": "node scripts/qa/check.js",
    "create:test-user": "node scripts/create-test-user.mjs",
    "confirm:users": "node scripts/create-test-user.mjs --confirm-pending",
    "cap:add:android": "npx cap add android",
    "cap:add:ios": "npx cap add ios",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "ci": "npm ci && npm run lint && npm run test && npm run build",
    "dev": "vite"
  },
